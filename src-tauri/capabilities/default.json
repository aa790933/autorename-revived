{
  "identifier": "default",
  "description": "Default capabilities for AutoRename-Revived",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    "opener:default"
  ]
}
