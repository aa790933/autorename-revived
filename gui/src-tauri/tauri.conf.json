{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/.schema/schema.json",
  "productName": "AutoRename Revived",
  "version": "1.0.0",
  "identifier": "com.autorename.revived",
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "beforeDevCommand": "pnpm run dev",
    "devPath": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AutoRename Revived",
        "width": 900,
        "height": 650,
        "resizable": true,
        "decorations": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "store": {
      "scope": ["$APP_DATA/**"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerIcon": "icons/icon.ico"
      }
    }
  }
}