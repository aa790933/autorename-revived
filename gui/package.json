{
  "name": "autorename-revived-gui",
  "private": true,
  "version": "3.0.4",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:css": "npx @tailwindcss/cli -i ./src/css/index.css -o ./assets/css/output.css --minify",
    "colors": "node scripts/generate-colors.js --config colors.json --output src/css/generated-colors.css --format css",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate-app-icons.cjs --config icons.config.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-shell": "2.3.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@tauri-apps/cli": "2.10.1",
    "@vitest/coverage-v8": "^4.0.0",
    "culori": "^4.0.2",
    "jsdom": "^26.0.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@parcel/watcher"
    ]
  }
}